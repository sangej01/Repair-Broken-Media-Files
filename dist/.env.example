# Repair Broken Media Files Configuration
# Copy this file to .env and fill in your values

# Radarr connection
RADARR_URL=http://mforum-ms01-a.tail425a06.ts.net
RADARR_PORT=8989
RADARR_API=your-api-key-here

# Email notifications (Gmail)
# Generate an app password at https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# PostgreSQL connection string (only needed if DB_BACKEND=postgres in config.py)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Stall detector: kill a decode that makes ZERO progress for this many seconds
# (separate from the per-file Timeout/file budget). Raise it if a slow/busy NAS
# stalls transiently under parallel load; set 0 to disable. Default 300 (5 min).
# REPAIR_STALL_LIMIT_SEC=300

# Network drive self-healing (Z: NAS drive used for library roots and DB backups).
# Set these to allow the app to auto-remount Z: if it drops.
# Leave REPAIR_Z_USER empty to disable drive self-healing entirely.
# REPAIR_Z_UNC=\\192.168.1.198\Media2
# REPAIR_Z_USER=your-nas-username
# REPAIR_Z_PASS=your-nas-password